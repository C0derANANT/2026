# Local LLMs (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
ANALYTICS_MODEL=llama2

# Optional free image APIs. Leave blank to use the built-in local storyboard art.
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# Optional local image generation through Automatic1111's API.
AUTOMATIC1111_URL=http://127.0.0.1:7861

# Optional folder of music you have already downloaded with the right licence
# (for example from Pixabay Music or YouTube Audio Library).
MUSIC_LIBRARY_DIR=

# Local speech and subtitle models.
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
WHISPER_MODEL=base

# Set this if ffmpeg is not exposed on PATH.
FFMPEG_BIN=ffmpeg
